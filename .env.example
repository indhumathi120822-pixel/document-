# ==========================================
# DocuMind AI - Environment Configuration
# ==========================================

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# For local development or external hosting (e.g. Vercel), obtain a key from:
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY="your_gemini_api_key_here"

# VITE_API_URL: Target endpoint for document extraction.
# In local development: http://localhost:3000/api/extract or relative /api/extract
# On Vercel: /api/extract
VITE_API_URL="/api/extract"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="http://localhost:3000"
